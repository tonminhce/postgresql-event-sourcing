meta {
  name: Place Order
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "riderId": "{{riderId}}",
    "price": "120.00",
    "route": [
      {
        "address": "Kyiv, 17A Polyjana Street",
        "lat": 50.5198,
        "lon": 30.46719
      },
      {
        "address": "Kyiv, 18V Novokostyantynivska Street",
        "lat": 50.48509,
        "lon": 30.48517
      }
    ]
  }
}

script:post-response {
      if (res.getStatus() === 201) {
        bru.setEnvVar("orderId", res.getBody().orderId);
      }
    
}

tests {
      test("returns 201 Created", function () {
        expect(res.getStatus()).to.equal(201);
      });

      test("returns an orderId", function () {
        expect(res.getBody()).to.have.property("orderId");
        expect(res.getBody().orderId).to.be.a("string");
      });

      test("points to the created order with the Location header", function () {
        expect(res.getHeader("location")).to.equal("/orders/" + res.getBody().orderId);
      });

      test("is not an idempotent replay", function () {
        expect(res.getHeader("idempotent-replayed")).to.be.undefined;
      });
    
}

docs {
      Creates a new order (write model).

      The `Idempotency-Key` header is generated fresh on every run (`{{$guid}}`), so
      each run creates a brand new order and the whole folder stays re-runnable.

      The server derives the order id from the key
      (`UUID.nameUUIDFromBytes(key)`), so the same key always maps to the same order.

      The resulting `orderId` is stored in the `orderId` environment variable and
      consumed by the rest of the folder.
    
}
