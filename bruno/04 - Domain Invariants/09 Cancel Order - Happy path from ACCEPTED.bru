meta {
  name: Cancel Order - Happy path from ACCEPTED
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/orders/{{domainOrderId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "CANCELLED",
    "reason": "Passenger changed mind"
  }
}

tests {
      test("returns 200", function () {
        expect(res.getStatus()).to.equal(200);
      });
    
}

docs {
      Cancellation is allowed from `PLACED`, `ADJUSTED` and `ACCEPTED`.
    
}
