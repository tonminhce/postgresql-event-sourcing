meta {
  name: Cancel Order - When completed
  type: http
  seq: 14
}

put {
  url: {{baseUrl}}/orders/{{completedOrderId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "CANCELLED",
    "reason": "Passenger changed mind"
  }
}

tests {
      test("returns 409 Conflict", function () {
        expect(res.getStatus()).to.equal(409);
      });

      test("is a problem details response", function () {
        expect(res.getHeader("content-type")).to.include("application/problem+json");
        expect(res.getBody().code).to.equal("ORDER_STATE_CONFLICT");
      });

      test("reports the current status", function () {
        expect(res.getBody().detail).to.include("Order in status COMPLETED can't be cancelled");
      });
    
}

docs {
      A completed order is terminal and can no longer be cancelled.
    
}
