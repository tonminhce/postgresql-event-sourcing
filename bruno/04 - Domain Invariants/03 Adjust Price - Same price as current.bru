meta {
  name: Adjust Price - Same price as current
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/orders/{{domainOrderId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "ADJUSTED",
    "price": "120.00"
  }
}

tests {
      test("returns 422 Unprocessable Content", function () {
        expect(res.getStatus()).to.equal(422);
      });

      test("is a problem details response", function () {
        expect(res.getHeader("content-type")).to.include("application/problem+json");
        expect(res.getBody().code).to.equal("VALIDATION_FAILED");
      });

      test("rejects a no-op adjustment", function () {
        expect(res.getBody().detail).to.include("cannot be identical to current price");
      });
    
}

docs {
      The order was placed with price 120.00, so adjusting it to 120.00 is a no-op
      and is rejected.
    
}
