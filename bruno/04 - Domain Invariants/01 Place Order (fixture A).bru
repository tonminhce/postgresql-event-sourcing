meta {
  name: Place Order (fixture A)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "riderId": "{{riderId}}",
    "price": "120.00",
    "route": [
      {
        "address": "Kyiv, fixture A",
        "lat": 50.5198,
        "lon": 30.46719
      }
    ]
  }
}

script:post-response {
      if (res.getStatus() === 200) {
        bru.setEnvVar("domainOrderId", res.getBody().orderId);
      }
    
}

tests {
      test("returns 200 with an orderId", function () {
        expect(res.getStatus()).to.equal(200);
        expect(res.getBody()).to.have.property("orderId");
      });
    
}

docs {
      Fixture for this folder. Run the folder (not a single request) so the
      fixtures are created first. A fresh key is used on every run.
    
}
