meta {
  name: Adjust Price - Negative price
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/orders/{{domainOrderId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "ADJUSTED",
    "price": "-10.00"
  }
}

tests {
      test("returns 400", function () {
        expect(res.getStatus()).to.equal(400);
      });

      test("rejects a non-positive price", function () {
        expect(res.getBody().error).to.include("New price must be strictly positive");
      });
    
}
