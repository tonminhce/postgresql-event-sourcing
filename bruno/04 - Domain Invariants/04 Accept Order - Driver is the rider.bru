meta {
  name: Accept Order - Driver is the rider
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/orders/{{domainOrderId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "ACCEPTED",
    "driverId": "{{riderId}}"
  }
}

tests {
      test("returns 400", function () {
        expect(res.getStatus()).to.equal(400);
      });

      test("rejects the rider accepting their own ride", function () {
        expect(res.getBody().error).to.include("own ride request");
      });
    
}
