meta {
  name: Accept Order - Driver is the rider
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/orders/{{domainOrderId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "ACCEPTED",
    "driverId": "{{riderId}}"
  }
}

tests {
      test("returns 422 Unprocessable Content", function () {
        expect(res.getStatus()).to.equal(422);
      });

      test("is a problem details response", function () {
        expect(res.getHeader("content-type")).to.include("application/problem+json");
        expect(res.getBody().code).to.equal("VALIDATION_FAILED");
      });

      test("rejects the rider accepting their own ride", function () {
        expect(res.getBody().detail).to.include("own ride request");
      });
    
}
