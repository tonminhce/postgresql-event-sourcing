meta {
  name: Complete Order - Already completed
  type: http
  seq: 15
}

put {
  url: {{baseUrl}}/orders/{{completedOrderId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "COMPLETED"
  }
}

tests {
      test("returns 400", function () {
        expect(res.getStatus()).to.equal(400);
      });

      test("reports the current status", function () {
        expect(res.getBody().error).to.include("can't be completed");
      });
    
}
