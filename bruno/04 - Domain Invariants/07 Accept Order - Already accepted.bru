meta {
  name: Accept Order - Already accepted
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/orders/{{domainOrderId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "ACCEPTED",
    "driverId": "{{driverId}}"
  }
}

tests {
      test("returns 400", function () {
        expect(res.getStatus()).to.equal(400);
      });

      test("reports the current status", function () {
        expect(res.getBody().error).to.include("Can't accept order in status ACCEPTED");
      });
    
}
