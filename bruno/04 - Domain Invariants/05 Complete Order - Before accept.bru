meta {
  name: Complete Order - Before accept
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/orders/{{domainOrderId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "COMPLETED"
  }
}

tests {
      test("returns 409 Conflict", function () {
        expect(res.getStatus()).to.equal(409);
      });

      test("is a problem details response", function () {
        expect(res.getHeader("content-type")).to.include("application/problem+json");
        expect(res.getBody().code).to.equal("ORDER_STATE_CONFLICT");
      });

      test("reports the current status", function () {
        expect(res.getBody().detail).to.include("can't be completed");
      });
    
}

docs {
      `COMPLETED` is only reachable from `ACCEPTED`.
    
}
