meta {
  name: Cancel Order - Already cancelled
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/orders/{{domainOrderId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "CANCELLED",
    "reason": "Second attempt"
  }
}

tests {
      test("returns 409 Conflict", function () {
        expect(res.getStatus()).to.equal(409);
      });

      test("is a problem details response", function () {
        expect(res.getHeader("content-type")).to.include("application/problem+json");
        expect(res.getBody().code).to.equal("ORDER_STATE_CONFLICT");
      });

      test("reports the current status", function () {
        expect(res.getBody().detail).to.include("Order in status CANCELLED can't be cancelled");
      });
    
}
