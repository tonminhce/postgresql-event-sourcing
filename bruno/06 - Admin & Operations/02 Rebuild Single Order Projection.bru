meta {
  name: Rebuild Single Order Projection
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/admin/projections/orders/{{orderId}}/rebuild
  body: none
  auth: none
}

tests {
      test("returns 200", function () {
        expect(res.getStatus()).to.equal(200);
      });

      test("reports success and the order id", function () {
        expect(res.getBody().status).to.equal("SUCCESS");
        expect(res.getBody().orderId).to.equal(bru.getEnvVar("orderId"));
      });
    
}
