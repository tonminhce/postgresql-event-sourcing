meta {
  name: Rebuild Single Order Projection - Unknown id
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/admin/projections/rebuild/orders/{{unknownOrderId}}
  body: none
  auth: none
}

tests {
      test("returns 404", function () {
        expect(res.getStatus()).to.equal(404);
      });

      test("is a problem details response", function () {
        expect(res.getHeader("content-type")).to.include("application/problem+json");
        expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
      });

      test("explains that the order does not exist", function () {
        expect(res.getBody().detail).to.include("Order not found for ID");
      });
    
}

docs {
      An unknown order id has no events, so there is no order to rebuild a
      projection from. The service reports it as `404 Not Found` instead of
      inserting a projection with a `null` status.
    
}
