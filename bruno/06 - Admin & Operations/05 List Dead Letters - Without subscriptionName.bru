  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/admin/subscriptions/dlq?limit=50
  body: none
  auth: none
}

tests {
      test("returns 200", function () {
        expect(res.getStatus()).to.equal(200);
      });

      test("returns an array", function () {
        expect(res.getBody()).to.be.an("array");
      });
    
}

docs {
      `subscriptionName` is optional: when it is omitted the dead letters of every
      subscription are returned.
    
}
