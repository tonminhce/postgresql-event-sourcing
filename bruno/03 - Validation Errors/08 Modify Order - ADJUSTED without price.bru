meta {
  name: Modify Order - ADJUSTED without price
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/orders/{{orderId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "ADJUSTED"
  }
}

tests {
      test("returns 400", function () {
        expect(res.getStatus()).to.equal(400);
      });

      test("explains that price is required for ADJUSTED", function () {
        expect(res.getBody().error).to.include("price");
      });
    
}
