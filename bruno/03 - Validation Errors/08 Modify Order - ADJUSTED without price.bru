meta {
  name: Modify Order - ADJUSTED without price
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/orders/{{orderId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "ADJUSTED"
  }
}

tests {
      test("returns 422 Unprocessable Content", function () {
        expect(res.getStatus()).to.equal(422);
      });

      test("is a problem details response", function () {
        expect(res.getHeader("content-type")).to.include("application/problem+json");
        expect(res.getBody().code).to.equal("VALIDATION_FAILED");
      });

      test("explains that price is required for ADJUSTED", function () {
        expect(res.getBody().detail).to.include("price");
      });
    
}
