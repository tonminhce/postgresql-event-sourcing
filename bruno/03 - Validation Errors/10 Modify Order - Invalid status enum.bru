meta {
  name: Modify Order - Invalid status enum
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/orders/{{orderId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "FLYING"
  }
}

tests {
      test("returns 400", function () {
        expect(res.getStatus()).to.equal(400);
      });

      test("returns the Spring problem-detail error shape", function () {
        expect(res.getBody().status).to.equal(400);
        expect(res.getBody().title).to.equal("Bad Request");
      });
    
}

docs {
      An unknown enum constant cannot be deserialized, so the request never reaches
      the domain. The error body is Spring's default shape
      (`title` / `status` / `detail` / `instance`) rather than the app's
      `error` / `code` shape.
    
}
