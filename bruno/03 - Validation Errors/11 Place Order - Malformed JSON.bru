meta {
  name: Place Order - Malformed JSON
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  { "riderId": "broken"
}

tests {
      test("returns 400", function () {
        expect(res.getStatus()).to.equal(400);
      });

      test("returns the Spring problem-detail error shape", function () {
        expect(res.getBody().status).to.equal(400);
        expect(res.getBody().title).to.equal("Bad Request");
      });
    
}
