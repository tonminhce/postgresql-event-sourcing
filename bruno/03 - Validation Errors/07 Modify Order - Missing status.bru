meta {
  name: Modify Order - Missing status
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/orders/{{orderId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "price": "10.00"
  }
}

tests {
      test("returns 400", function () {
        expect(res.getStatus()).to.equal(400);
      });

      test("is a problem details response", function () {
        expect(res.getHeader("content-type")).to.include("application/problem+json");
        expect(res.getBody().code).to.equal("VALIDATION_ERROR");
      });

      test("explains that status is required", function () {
        expect(res.getBody().detail).to.include("status");
      });
    
}
