meta {
  name: Modify Order - Missing status
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/orders/{{orderId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "price": "10.00"
  }
}

tests {
      test("returns 400", function () {
        expect(res.getStatus()).to.equal(400);
      });

      test("explains that status is required", function () {
        expect(res.getBody().error).to.include("status");
      });
    
}
