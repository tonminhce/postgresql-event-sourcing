meta {
  name: Place Order - Zero price
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "riderId": "{{riderId}}",
    "price": "0"
  }
}

tests {
      test("returns 400", function () {
        expect(res.getStatus()).to.equal(400);
      });

      test("rejects a non-positive price", function () {
        expect(res.getBody().error).to.include("Price must be strictly positive");
      });
    
}
