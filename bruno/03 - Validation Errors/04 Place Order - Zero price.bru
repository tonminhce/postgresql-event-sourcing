meta {
  name: Place Order - Zero price
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "riderId": "{{riderId}}",
    "price": "0"
  }
}

tests {
      test("returns 422 Unprocessable Content", function () {
        expect(res.getStatus()).to.equal(422);
      });

      test("is a problem details response", function () {
        expect(res.getHeader("content-type")).to.include("application/problem+json");
        expect(res.getBody().code).to.equal("VALIDATION_FAILED");
      });

      test("rejects a non-positive price", function () {
        expect(res.getBody().detail).to.include("Price must be strictly positive");
      });
    
}
