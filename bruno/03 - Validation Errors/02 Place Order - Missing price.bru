meta {
  name: Place Order - Missing price
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "riderId": "{{riderId}}"
  }
}

tests {
      test("returns 400", function () {
        expect(res.getStatus()).to.equal(400);
      });

      test("is a problem details response", function () {
        expect(res.getHeader("content-type")).to.include("application/problem+json");
        expect(res.getBody().code).to.equal("VALIDATION_ERROR");
      });

      test("explains which fields are missing", function () {
        expect(res.getBody().detail).to.include("price");
      });
    
}
