get {
  url: {{baseUrl}}/actuator/health
  body: none
  auth: none
}

tests {
      test("returns 200", function () {
        expect(res.getStatus()).to.equal(200);
      });

      test("reports the application as UP", function () {
        expect(res.getBody().status).to.equal("UP");
      });
    
}

docs {
