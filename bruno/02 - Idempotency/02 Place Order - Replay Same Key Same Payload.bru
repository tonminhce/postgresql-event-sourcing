meta {
  name: Place Order - Replay Same Key Same Payload
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{idemRunKey}}
}

body:json {
  {
    "riderId": "{{riderId}}",
    "price": "120.00",
    "route": [
      {
        "address": "Kyiv, 17A Polyjana Street",
        "lat": 50.5198,
        "lon": 30.46719
      }
    ]
  }
}

tests {
      test("returns 201 Created", function () {
        expect(res.getStatus()).to.equal(201);
      });

      test("is flagged as an idempotent replay", function () {
        expect(res.getHeader("idempotent-replayed")).to.equal("true");
        expect(res.getHeader("idempotency-key")).to.equal(bru.getEnvVar("idemRunKey"));
      });

      test("returns the same order id as the first call", function () {
        expect(res.getBody().orderId).to.equal(bru.getEnvVar("idemOrderId"));
      });
    
}

docs {
      Identical key + identical payload => the cached response is returned and no
      new event is appended. This is the RFC 9440 / Stripe idempotency contract.
    
}
