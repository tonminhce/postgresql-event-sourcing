meta {
  name: Place Order (second order)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{idemRunKey}}-second
}

body:json {
  {
    "riderId": "{{riderId}}",
    "price": "120.00",
    "route": [
      {
        "address": "Kyiv, 17A Polyjana Street",
        "lat": 50.5198,
        "lon": 30.46719
      }
    ]
  }
}

script:post-response {
      if (res.getStatus() === 201) {
        bru.setEnvVar("idemSecondOrderId", res.getBody().orderId);
      }
    
}

tests {
      test("returns 201 Created with an orderId", function () {
        expect(res.getStatus()).to.equal(201);
        expect(res.getBody()).to.have.property("orderId");
      });
    
}

docs {
      A second order, for the requests that need another aggregate.
    
}
