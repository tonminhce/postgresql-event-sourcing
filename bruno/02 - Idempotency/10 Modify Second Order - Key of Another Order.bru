meta {
  name: Modify Second Order - Key of Another Order
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/orders/{{idemSecondOrderId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{idemRunKey}}-modify
}

body:json {
  {
    "status": "ADJUSTED",
    "price": "175.00"
  }
}

tests {
      test("returns 409 Conflict", function () {
        expect(res.getStatus()).to.equal(409);
      });

      test("returns the IDEMPOTENCY_CONFLICT code", function () {
        expect(res.getHeader("content-type")).to.include("application/problem+json");
        expect(res.getBody().code).to.equal("IDEMPOTENCY_CONFLICT");
      });

      test("explains that the key was used for another order", function () {
        expect(res.getBody().detail).to.include("different order");
      });
    
}

docs {
      The key of the `Modify Order - First Call` request is reused for another
      order, with the very same payload.

      The payload matches, so the server cannot reject the request as a payload
      mismatch: it rejects it because the key already identifies a command on
      another aggregate.
    
}
