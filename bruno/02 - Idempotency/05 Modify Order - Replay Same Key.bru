meta {
  name: Modify Order - Replay Same Key
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/orders/{{idemOrderId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{idemRunKey}}-modify
}

body:json {
  {
    "status": "ADJUSTED",
    "price": "175.00"
  }
}

tests {
      test("returns 200", function () {
        expect(res.getStatus()).to.equal(200);
      });

      test("is flagged as an idempotent replay", function () {
        expect(res.getHeader("idempotent-replayed")).to.equal("true");
      });
    
}
