meta {
  name: Modify Order - Unknown id
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/orders/{{unknownOrderId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "COMPLETED"
  }
}

tests {
      test("returns 409 Conflict", function () {
        expect(res.getStatus()).to.equal(409);
      });

      test("is a problem details response", function () {
        expect(res.getHeader("content-type")).to.include("application/problem+json");
        expect(res.getBody().code).to.equal("ORDER_STATE_CONFLICT");
      });

      test("reports a null aggregate status", function () {
        expect(res.getBody().detail).to.include("status null");
      });
    
}
