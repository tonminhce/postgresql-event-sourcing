meta {
  name: Modify Order - Unknown id
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/orders/{{unknownOrderId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "COMPLETED"
  }
}

tests {
      test("returns 400", function () {
        expect(res.getStatus()).to.equal(400);
      });

      test("reports a null aggregate status", function () {
        expect(res.getBody().error).to.include("status null");
      });
    
}

docs {
      Known quirk: the aggregate store returns an empty aggregate (status `null`)
      for an unknown id instead of throwing, so the request is rejected with `400`
      rather than `404`.
    
}
