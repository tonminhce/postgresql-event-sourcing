meta {
  name: Replay Dead Letter - Unknown id
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/admin/subscriptions/replay/dlq/999999
  body: none
  auth: none
}

tests {
      test("returns 404", function () {
        expect(res.getStatus()).to.equal(404);
      });

      test("is a problem details response", function () {
        expect(res.getHeader("content-type")).to.include("application/problem+json");
        expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
      });

      test("explains that the record does not exist", function () {
        expect(res.getBody().detail).to.include("not found");
      });
    
}
