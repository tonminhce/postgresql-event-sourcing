meta {
  name: Get Order - Unknown id
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/orders/{{unknownOrderId}}
  body: none
  auth: none
}

tests {
      test("returns 404", function () {
        expect(res.getStatus()).to.equal(404);
      });

      test("is a problem details response", function () {
        expect(res.getHeader("content-type")).to.include("application/problem+json");
        expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
        expect(res.getBody().detail).to.include("Order not found for ID");
      });
    
}
