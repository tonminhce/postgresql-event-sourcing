meta {
  name: Get Order - Malformed UUID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/orders/not-a-uuid
  body: none
  auth: none
}

tests {
      test("returns 400", function () {
        expect(res.getStatus()).to.equal(400);
      });

      test("returns the Spring problem-detail error shape", function () {
        expect(res.getBody().status).to.equal(400);
        expect(res.getBody().title).to.equal("Bad Request");
      });
    
}
