@startuml

scale max 1024 width
scale max 900 height

set separator none

package jakarta.persistence {

  annotation Entity
  annotation Embeddable
}

package org.springframework.data.domain {

  interface Persistable {
    getId(): Object
    isNew(): boolean
  }
}

package com.example.eventsourcing {

  package com.example.eventsourcing.projection {

    class OrderProjection {
      -id: UUID
      -version: int
      -status: OrderStatus
      -riderId: UUID
      -price: BigDecimal
      -route: List<WaypointProjection>
      -driverId: UUID
      -placedDate: OffsetDateTime
      -acceptedDate: OffsetDateTime
      -completedDate: OffsetDateTime
      -cancelledDate: OffsetDateTime
    }

    class WaypointProjection {
      -address: String
      -latitude: double
      -longitude: double
    }
  }

  package com.example.eventsourcing.dto {

    class OrderDto << record >> {
      orderId: UUID
      eventType: String
      eventTimestamp: OffsetDateTime
      version: int
      status: OrderStatus
      riderId: UUID
      price: BigDecimal
      route: List<WaypointDto>
      driverId: UUID
    }

    class PlaceOrderRequest << record >> {
      riderId: UUID
      price: BigDecimal
      route: List<WaypointDto>
    }

    class ModifyOrderRequest << record >> {
      status: OrderStatus
      price: BigDecimal
      driverId: UUID
      cancellationReason: String
    }

    class WaypointDto << record >> {
      address: String
      latitude: double
      longitude: double
    }

    enum OrderStatus {
      PLACED
      ADJUSTED
      ACCEPTED
      COMPLETED
      CANCELLED
    }
  }
}

Persistable <|.. OrderProjection
OrderProjection *-- WaypointProjection
OrderProjection o-- OrderStatus
OrderProjection ..> Entity
WaypointProjection ..> Embeddable

OrderDto o-- WaypointDto
OrderDto o-- OrderStatus

PlaceOrderRequest o-- WaypointDto
ModifyOrderRequest o-- OrderStatus

@enduml
