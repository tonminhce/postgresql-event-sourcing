@startuml

hide circle

scale max 1280 width
scale max 1000 height

skinparam linetype ortho
skinparam packageStyle rectangle

package "Domain Model (Event Store & Outbox)" #line.dashed {
  entity "**ES_AGGREGATE**" {
    + ""ID"": //uuid [PK]//
    --
    *""VERSION"": //integer //
    *""AGGREGATE_TYPE"": //text //
  }

  entity "**ES_AGGREGATE_SNAPSHOT**" {
    + ""AGGREGATE_ID"": //uuid [PK][FK]//
    --
    *""VERSION"": //integer //
    *""JSON_DATA"": //jsonb //
  }

  entity "**ES_EVENT**" {
    + ""ID"": //bigserial [PK]//
    --
    *""TRANSACTION_ID"": //xid8 //
    *""AGGREGATE_ID"": //uuid [FK]//
    *""VERSION"": //integer //
    *""EVENT_TYPE"": //text //
    *""JSON_DATA"": //jsonb //
    *""METADATA"": //jsonb //
  }

  entity "**ES_IDEMPOTENCY_KEY**" {
    + ""KEY"": //text [PK]//
    --
    *""AGGREGATE_ID"": //uuid [FK]//
    *""STATUS_CODE"": //integer //
    *""RESPONSE_BODY"": //jsonb //
    *""STATUS"": //text //
    *""REQUEST_HASH"": //text //
    *""CREATED_AT"": //timestamp with time zone //
  }

  entity "**ES_EVENT_SUBSCRIPTION**" {
    + ""SUBSCRIPTION_NAME"": //text [PK]//
    --
    *""LAST_TRANSACTION_ID"": //xid8 //
    *""LAST_EVENT_ID"": //bigint //
  }

  entity "**ES_EVENT_SUBSCRIPTION_DEAD_LETTER**" {
    + ""ID"": //bigserial [PK]//
    --
    *""SUBSCRIPTION_NAME"": //text //
    *""EVENT_ID"": //bigint //
    *""TRANSACTION_ID"": //xid8 //
    *""AGGREGATE_ID"": //uuid //
    *""EVENT_TYPE"": //text //
    *""EXCEPTION_CLASS"": //text //
    *""ERROR_MESSAGE"": //text //
    *""STACK_TRACE"": //text //
    *""PAYLOAD"": //jsonb //
    *""CREATED_DATE"": //timestamp with time zone //
  }
}

package "Read Model (Projections)" #line.dashed {
  entity "**RM_ORDER**" ##[dotted] {
    + ""ID"": //uuid [PK]//
    --
    *""VERSION"": //integer //
    *""STATUS"": //text //
    *""RIDER_ID"": //uuid //
    *""PRICE"": //numeric(19,2) //
    *""DRIVER_ID"": //uuid //
    *""PLACED_DATE"": //timestamp without time zone //
    *""ACCEPTED_DATE"": //timestamp without time zone //
    *""CANCELLED_DATE"": //timestamp without time zone //
    *""COMPLETED_DATE"": //timestamp without time zone //
  }

  entity "**RM_ORDER_ROUTE**" ##[dotted] {
    + ""ORDER_ID"": //uuid [PK][FK]//
    + ""ADDRESS"": //text [PK]//
    --
    *""LATITUDE"": //double precision //
    *""LONGITUDE"": //double precision //
  }
}

"**ES_AGGREGATE_SNAPSHOT**" }-- "**ES_AGGREGATE**"
"**ES_EVENT**" }-- "**ES_AGGREGATE**"
"**ES_IDEMPOTENCY_KEY**" }-- "**ES_AGGREGATE**"
"**ES_EVENT_SUBSCRIPTION_DEAD_LETTER**" }.. "**ES_EVENT_SUBSCRIPTION**"
"**RM_ORDER_ROUTE**" }-- "**RM_ORDER**"

@enduml
